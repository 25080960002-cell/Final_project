WEB_PORT=8080
DB_USER=mapan
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_ACAK_PANJANG
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_ACAK_PANJANG
SESSION_TTL_HOURS=8
CORS_ORIGINS=https://domain-frontend-anda.com

# Isi untuk membuat akun administrator pertama, kemudian hapus nilai rahasia
# dari .env.docker setelah provisioning berhasil.
MAPAN_INITIAL_ADMIN_EMAIL=admin@organisasi.id
MAPAN_INITIAL_ADMIN_PASSWORD=GANTI_DENGAN_KATA_SANDI_MINIMAL_12_KARAKTER
MAPAN_INITIAL_ADMIN_NAME=Administrator MAPAN
MAPAN_INITIAL_ORG_NAME=Nama Organisasi
MAPAN_INITIAL_REGION_NAME=Kabupaten/Kota

# Untuk mengganti kata sandi administrator pada database yang sudah berisi akun.
MAPAN_ADMIN_EMAIL=admin@organisasi.id
MAPAN_ADMIN_PASSWORD=GANTI_DENGAN_KATA_SANDI_MINIMAL_12_KARAKTER

# Koordinat pusat wilayah (opsional, tetapi perlu agar cuaca aktif).
MAPAN_INITIAL_REGION_LATITUDE=
MAPAN_INITIAL_REGION_LONGITUDE=
