# Alamat API MAPAN (folder server/). Wajib diisi di Vercel dengan URL backend
# publik, misalnya https://mapan-api.up.railway.app
VITE_API_BASE_URL=http://localhost:4000

# Organisasi yang ditampilkan di dashboard.
VITE_ORGANIZATION_ID=1

# Kunci API Google Maps (Maps JavaScript API). Kosong/absen = halaman Peta lahan
# memakai mode skema GeoJSON. Ambil di console.cloud.google.com, aktifkan
# "Maps JavaScript API", lalu restart `npm run dev:all`.
VITE_GOOGLE_MAPS_API_KEY=
