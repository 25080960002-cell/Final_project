# Backend — Railway / Render / VPS Docker
# Salin nilai ini ke Environment Variables service API.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=true

DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=3306
DB_USER=mapan
DB_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_MINIMAL_16_KARAKTER
DB_NAME=mapan
DB_POOL_MAX=10

SESSION_TTL_HOURS=8
# Domain Vercel (boleh beberapa, pisahkan koma). Pola https://*.vercel.app didukung.
CORS_ORIGINS=https://mapan-web.vercel.app,https://*.vercel.app
# Lintas domain Vercel <-> Railway wajib SameSite=None + Secure.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

MEDIA_DIR=/data/media
GOOGLE_CLIENT_ID=

# Hanya untuk provisioning admin pertama; hapus setelah berhasil.
MAPAN_INITIAL_ADMIN_EMAIL=admin@organisasi.id
MAPAN_INITIAL_ADMIN_PASSWORD=GANTI_DENGAN_KATA_SANDI_MINIMAL_12_KARAKTER
MAPAN_INITIAL_ADMIN_NAME=Administrator MAPAN
MAPAN_INITIAL_ORG_NAME=Nama Organisasi
MAPAN_INITIAL_REGION_NAME=Kabupaten/Kota
MAPAN_INITIAL_REGION_LATITUDE=
MAPAN_INITIAL_REGION_LONGITUDE=
