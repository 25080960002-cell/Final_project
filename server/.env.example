# Port server
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
SESSION_TTL_HOURS=8

# Koneksi MySQL 8 (lokal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zian
DB_PASSWORD=
DB_NAME=mapan
DB_POOL_MAX=10

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provisioning administrator pertama (hanya dipakai saat menjalankan npm run provision-admin).
# Isi nilai ini sementara, jalankan provisioning, lalu hapus kata sandinya dari .env.
MAPAN_INITIAL_ADMIN_EMAIL=admin@organisasi.id
MAPAN_INITIAL_ADMIN_PASSWORD=GANTI_DENGAN_KATA_SANDI_MINIMAL_12_KARAKTER
MAPAN_INITIAL_ADMIN_NAME=Administrator MAPAN
MAPAN_INITIAL_ORG_NAME=Nama Organisasi
MAPAN_INITIAL_REGION_NAME=Kabupaten/Kota
# Koordinat opsional; cuaca memerlukan keduanya.
MAPAN_INITIAL_REGION_LATITUDE=
MAPAN_INITIAL_REGION_LONGITUDE=

# Ubah kata sandi admin yang sudah ada pada database sampel.
MAPAN_ADMIN_EMAIL=admin@organisasi.id
MAPAN_ADMIN_PASSWORD=GANTI_DENGAN_KATA_SANDI_MINIMAL_12_KARAKTER
